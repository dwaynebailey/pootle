#!/bin/bash

set -e

APP_DIR=$(readlink -f --canonicalize $(eval echo $APP_DIR))

cd $APP_DIR


function get_requirement () {
    curl -sO $APP_REQUIREMENTS/$1.txt
}

# The apt-installed 'virtualenv' (docker/root/install-root) ships without
# its bundled seed wheels on this image, so it falls back to downloading
# setuptools/pip/wheel from PyPI's simple index at bootstrap time — which
# 404s on the (long-defunct) standalone 'pkg-resources' package it asks
# for, and the whole thing fails with "failed with error code 2" before a
# venv is even created. Bootstrap pip properly via get-pip.py instead, and
# use a pip-installed virtualenv (last version with Python 2 support),
# which bundles working wheels. Verified during Phase 0, stream A2.
curl -sS https://bootstrap.pypa.io/pip/2.7/get-pip.py -o /tmp/get-pip.py
python2 /tmp/get-pip.py -q
python2 -m pip install -q "virtualenv<20"

if [ "$BUILD_IMAGE" == 'dev' ];
then
    echo "Installing dev env with: $APP_REQUIREMENTS"
    mkdir requirements
    cd requirements
    declare -a requirements=("_es_5" "base" "dev" "tests" "_docs" "_lint")
    for i in "${requirements[@]}"
    do
        get_requirement "$i"
    done
    cd ..
    python2 -m virtualenv .
    . bin/activate \
        && pip install --no-cache-dir -qr requirements/dev.txt \
        && pip install --no-cache-dir -qr requirements/_es_5.txt \
        && pip install --no-cache-dir -q \
               codecov==2.0.15 \
               coverage==4.5.1 \
               coveralls==1.3.0 \
        && pyclean .
else
    echo "Installing package: $APP_PKG"
    python2 -m virtualenv .
    # NOTE: --process-dependency-links was removed in pip 19 (this
    # bootstrap installs pip 20.3.4, the last release with Python 2
    # support) — this branch will fail as-is. Left unfixed here since it's
    # the PyPI-package install path, out of scope for the Phase 0
    # baseline; revisit alongside the Phase 4 build-pipeline work.
    . bin/activate \
        && pip install \
               -q \
               --no-cache-dir \
               --process-dependency-links \
               $APP_PKG \
        && pyclean .
fi
